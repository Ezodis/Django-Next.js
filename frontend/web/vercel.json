{
  "framework": "nextjs",
  "installCommand": "npm ci --no-fund",
  "buildCommand": "node --test localization/tests.cjs && npm run build",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}

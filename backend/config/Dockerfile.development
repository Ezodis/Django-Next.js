# backend/config/Dockerfile.development
# Multi-stage build for optimized image size
# Features: Auto-migrations, auto-restore, scheduled backups, non-root user
#
# This file is a shared template — keep it free of project-specific logic.
# To extend it for a specific project, create <app>/Dockerfile that does:
#   FROM ${BASE_IMAGE:-<project>-backend-base}
# and add only what that app needs. See backend/project.py (COMPOSE_SERVICES) for the build overwrite (backend-base service + backend override).

# ---------- Build Stage ----------
FROM python:3.12-slim-bookworm AS python-build-stage

WORKDIR /backend
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off

# Copy system package requirements first
COPY backend/requirements/packages.txt ./requirements/

# Install build deps from packages.txt
RUN set -e; \
    apt-get update; \
    # Extract package names: remove full-line comments, strip inline comments, filter empty lines
    PACKAGES=$(grep -v '^#' requirements/packages.txt | \
               sed 's/#.*//' | \
               grep -v '^$' | \
               tr '\n' ' ' | \
               sed 's/  */ /g'); \
    if [ -n "$PACKAGES" ]; then \
        echo "Installing packages from packages.txt: $PACKAGES"; \
        apt-get install -y --no-install-recommends $PACKAGES; \
    else \
        echo "Warning: No uncommented packages found in packages.txt"; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip first for better dependency resolution
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy only requirements first to leverage layer caching
COPY backend/requirements/ ./requirements/

# Build wheels (faster installs in runtime stage)
# --prefer-binary avoids building from source when possible
# Use --no-build-isolation to avoid temp directory issues
RUN mkdir -p /wheels && \
    pip wheel --wheel-dir /wheels --prefer-binary --no-build-isolation -r requirements/development.txt || \
    pip wheel --wheel-dir /wheels --prefer-binary -r requirements/development.txt

# ---------- Runtime Stage ----------
FROM python:3.12-slim-bookworm AS python-run-stage

WORKDIR /backend
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/backend \
    PIP_NO_CACHE_DIR=1

# ── Layer 1: stable base system packages (rarely changes) ─────────────────────
# These never change between builds unless you edit this block.
# Put them FIRST so they cache independently of requirements files.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    libpq-dev \
    gettext \
    curl \
    netcat-openbsd \
    cron \
    gzip \
    cpio \
    wget \
    gnupg ca-certificates \
 && mkdir -p /etc/apt/keyrings && wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt/ bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# ── Layer 2: project runtime packages ────────────────────────────────────────
COPY backend/requirements/runtime-packages.txt /backend/requirements/runtime-packages.txt
RUN set -e; \
    if [ -f /backend/requirements/runtime-packages.txt ]; then \
        apt-get update; \
        PACKAGES=$(grep -v '^#' /backend/requirements/runtime-packages.txt | \
                   sed 's/#.*//' | \
                   grep -v '^$' | \
                   tr '\n' ' ' | \
                   sed 's/  */ /g'); \
        if [ -n "$PACKAGES" ]; then \
            echo "Installing project-specific runtime packages: $PACKAGES"; \
            apt-get install -y --no-install-recommends $PACKAGES; \
        fi; \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "No project-specific runtime packages found, skipping..."; \
    fi

# ── Layer 3: Python packages from wheels ─────────────────────────────────────
COPY backend/requirements/ /backend/requirements/

# Copy wheels and install (no network at runtime; faster)
COPY --from=python-build-stage /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels /wheels/* \
 && rm -rf /wheels

# ── Layer 4: extra Python packages (auto-discovered) ─────────────────────────
# Installs any .txt file in requirements/ that isn't a core template file.
# Drop project.txt (or any named file) into requirements/ to add packages
# without touching this Dockerfile.
RUN for project_req in /backend/requirements/*.txt; do \
        filename=$(basename "$project_req"); \
        # Skip core template files (already installed above via development.txt) \
        if [ "$filename" = "base.txt" ] || \
           [ "$filename" = "development.txt" ] || \
           [ "$filename" = "deployment.txt" ]; then \
            continue; \
        fi; \
        # Skip non-Python requirement files \
        if [ "$filename" = "packages.txt" ] || \
           [ "$filename" = "runtime-packages.txt" ] || \
           [ "$filename" = "setup.txt" ]; then \
            continue; \
        fi; \
        # Install everything else (e.g. project.txt) \
        if [ -f "$project_req" ]; then \
            echo "Installing extra Python dependencies from $filename..."; \
            pip install --no-cache-dir -r "$project_req"; \
        fi; \
    done

# Create non-root user for safety
RUN addgroup --system django && adduser --system --ingroup django django

# Copy project source with ownership for the django user
COPY --chown=django:django backend/ /backend

# Copy and setup backup scripts
# Two scripts: backup.sh (basic) and backup_gcs.sh (with GCS support)
COPY --chown=django:django backend/backup/backup.sh /backend/backup/backup.sh
COPY --chown=django:django backend/backup/backup_gcs.sh /backend/backup/backup_gcs.sh
RUN chmod +x /backend/backup/backup.sh /backend/backup/backup_gcs.sh && \
    mkdir -p /backend/backup/start /backend/backup/db /backend/backup/snapshots && \
    chown -R django:django /backend/backup

# Setup cron for daily database backups at 2:00 AM
RUN echo "0 2 * * * /backend/backup/backup.sh db >> /backend/backup/backup.log 2>&1" | crontab -u django -

# Ensure django user has write permissions to the backend directory
RUN chown -R django:django /backend && \
    chmod -R 755 /backend && \
    mkdir -p /backend/media && \
    chown -R django:django /backend/media && \
    chmod -R 755 /backend/media

# Set environment variables with defaults
ENV DB_HOST=db \
    DB_PORT=5432 \
    DB_NAME=postgres \
    DB_USER=postgres \
    DB_PASSWORD=postgres \
    DJANGO_SETTINGS_MODULE=config.settings \
    MAX_WAIT=60 \
    SLEEP=2 \
    WAITED=0

COPY backend/config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Keep container running as root so cron can start, but switch to django for app
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
